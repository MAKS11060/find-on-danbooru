{
  "$schema": "https://json.schemastore.org/chrome-manifest",
  "manifest_version": 3,
  "name": "Find on Danbooru",
  "version": "1.3",
  "description": "Adds a context menu item to search for images and artists on Danbooru",
  "icons": {
    "128": "src/icons/danbooru-logo.png"
  },
  "host_permissions": [
    "https://danbooru.donmai.us/*",
    "https://www.pixiv.net/*",
    "https://x.com/*"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "permissions": [
    "contextMenus"
  ]
}
